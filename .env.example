# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). The anon key is safe
# to expose client-side — it's the public key, protected by the row-level
# security policies in supabase/schema.sql. Never put the service_role
# key here or anywhere in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
